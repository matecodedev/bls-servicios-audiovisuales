---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="logo-container reveal-scale">
        <img
          src="/logo_hero.webp"
          alt="Logo BLS Servicios Audiovisuales"
          class="hero-logo"
          width="300"
          height="300"
        />
      </div>
      <h1 class="reveal reveal-delay-1">Soluciones técnicas profesionales para tus eventos</h1>
      <p class="reveal reveal-delay-2">
        Iluminación, sonido, video y escenarios para todo tipo de eventos.
        Hacemos que tu evento brille con equipamiento de última generación.
      </p>
      <div class="hero-buttons reveal reveal-delay-3">
        <a
          href="#contacto"
          class="btn btn-primary"
          aria-label="Contáctanos para solicitar servicios audiovisuales"
          >Contáctanos</a
        >
        <a
          href="#servicios"
          class="btn btn-secondary"
          aria-label="Ver nuestros servicios audiovisuales"
          >Nuestros Servicios</a
        >
      </div>
    </div>
  </div>
  <!-- Indicador de scroll -->
  <div class="scroll-indicator" aria-hidden="true">
    <span class="scroll-text">Scroll</span>
    <div class="scroll-arrow">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
      url("/hero-background.webp");
    background-size: cover;
    background-position: center;
    color: white;
    height: 100vh;
    display: flex;
    align-items: flex-start; /* Cambiado de center a flex-start para alinear arriba */
    padding-top: 10vh; /* Añadido espacio superior */
    text-align: center;
    padding-bottom: 0; /* Eliminado el padding-bottom */
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .logo-container {
    margin-bottom: 2rem;
    margin-top: -3rem; /* Mover el logo más arriba */
  }

  .hero-logo {
    max-width: 500px;
    width: 100%;
    height: auto;
    filter: drop-shadow(0px 0px 10px rgba(255, 255, 255, 0.5));
    transition: transform 0.3s ease;
  }

  .hero-logo:hover {
    transform: scale(1.05);
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero p {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  /* Indicador de scroll */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: white;
    opacity: 0.8;
    animation: bounce 2s infinite;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    animation: scrollDown 1.5s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  @keyframes scrollDown {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(10px);
      opacity: 0.5;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Ocultar indicador cuando se hace scroll */
  .scroll-indicator.hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 12vh;
    }

    .hero-logo {
      max-width: 180px;
      width: 60%;
    }

    .logo-container {
      margin-bottom: 1.5rem;
      margin-top: 0;
    }

    .hero h1 {
      font-size: 2rem;
      margin-bottom: 0.8rem;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 1.2rem;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .hero-buttons .btn {
      width: 100%;
      max-width: 280px;
    }
  }

  /* Para dispositivos aún más pequeños */
  @media (max-width: 480px) {
    .hero-logo {
      max-width: 160px; /* Aún más pequeño para móviles pequeños */
    }

    .hero h1 {
      font-size: 1.8rem;
    }

    .scroll-indicator {
      bottom: 1rem;
    }

    .scroll-text {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollIndicator = document.querySelector('.scroll-indicator');
    
    if (scrollIndicator) {
      // Ocultar cuando se hace scroll
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        
        if (currentScroll > 100) {
          scrollIndicator.classList.add('hidden');
        } else {
          scrollIndicator.classList.remove('hidden');
        }
        
        lastScroll = currentScroll;
      });

      // Hacer scroll suave al hacer clic
      scrollIndicator.addEventListener('click', () => {
        window.scrollTo({
          top: window.innerHeight,
          behavior: 'smooth'
        });
      });
    }
  });
</script>
