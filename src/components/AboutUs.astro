---
const timelineEvents = [
  {
    year: "2000",
    title: "Fundación",
    description:
      "BLS Servicios Audiovisuales nace con la visión de revolucionar la tecnología para eventos en el país.",
  },
  {
    year: "2010",
    title: "Expansión",
    description:
      "Ampliamos nuestro inventario con equipos de última generación y duplicamos nuestro personal técnico.",
  },
  {
    year: "2018",
    title: "Premio a la innovación",
    description:
      "Recibimos reconocimiento en la industria por nuestras trayectoria en soluciones innovadoras para eventos.",
  },
  {
    year: "2020",
    title: "Eventos virtuales",
    description:
      "Lanzamos nuestra división de eventos virtuales y transmisiones en vivo de alta calidad.",
  },
  {
    year: "2023",
    title: "Pantallas de Led de alta definición",
    description:
      "Ampliamos nuestro inventario con equipos con pantallas led de última generación.",
  },
  {
    year: "2024",
    title: "Internacional",
    description:
      "Comenzamos a brindar servicios en países vecinos, expandiendo nuestra huella en Latinoamérica.",
  },
];

const values = [
  {
    icon: "⚙️",
    title: "Excelencia técnica",
    description:
      "Todas nuestras áreas mancomunadas hacia la calidad operativa y técnica.",
  },
  {
    icon: "🤝",
    title: "Compromiso",
    description:
      "Creemos en la cooperación interpersonal en todas nuestras áreas. ",
  },
  {
    icon: "💡",
    title: "Innovación",
    description:
      "Nos desarrollamos y nos adaptamos a los cambios permanentemente.",
  },
  {
    icon: "🔄",
    title: "Adaptabilidad",
    description:
      "Nos adaptamos rápidamente a los cambios y requerimientos especiales.",
  },
];
---

<section id="sobre-nosotros" class="about">
  <div class="container">
    <div class="section-title reveal">
      <h2>Sobre Nosotros</h2>
      <p>
        Conoce más acerca de nuestra experiencia y compromiso con la excelencia
        en eventos técnicos
      </p>
    </div>

    <div class="about-content">
      <div class="about-image reveal-left">
        <img
          src="/about-image.webp"
          alt="Equipo técnico de BLS Servicios Audiovisuales trabajando en el montaje de equipamiento audiovisual para un evento corporativo en Buenos Aires"
          width="800"
          height="400"
          loading="lazy"
        />
      </div>
      <div class="about-text reveal-right">
        <h3>Quiénes Somos</h3>
        <p>
          BLS Servicios Audiovisuales es una empresa dedicada a prestar
          servicios audiovisuales en eventos corporativos y también sociales,
          que cuenta con una amplia gama de tecnología para ofrecer a los
          clientes y satisfacer sus necesidades, ya sea un pequeño evento
          interno o un congreso internacional, tenemos la capacidad técnica y
          operativa de abarcar todos los posibles escenarios en cuanto a
          realización de eventos.
        </p>

        <h3>Nuestra Misión</h3>
        <p>
          Ser el enlace entre lo que una empresa quiere comunicar y como quiere
          comunicarlo; y el púbico al cual esta dirigido. Esa comunicación es
          cada ves mas eficiente, gracias al continuo cambio al que BLS se
          adapta, tanto del cliente como del contexto; respondiendo siempre con
          la mas avanzada tecnología y el mas excelso servicio.
        </p>

        <h3>Nuestra Visión</h3>
        <p>
          Ser la empresa en la cual cada persona que la integra este dispuesto a
          dar siempre lo mejor de si, para con BLS como para con el cliente
          Satisfacer a los clientes desde el inicio del proceso, entendiendo sus
          necesidades
        </p>

        <div class="stats">
          <div class="stat">
            <span class="stat-number" data-target="250" data-suffix="+">0+</span>
            <span class="stat-text">Eventos Anuales</span>
          </div>
          <div class="stat">
            <span class="stat-number" data-target="20" data-suffix="+">0+</span>
            <span class="stat-text">Profesionales</span>
          </div>
          <div class="stat">
            <span class="stat-number" data-target="98" data-suffix="%">0%</span>
            <span class="stat-text">Clientes Satisfechos</span>
          </div>
        </div>
      </div>
    </div>

    <div class="values-section">
      <div class="section-subtitle reveal">
        <h2>Nuestros Valores</h2>
        <p>Los principios que guían nuestro trabajo día a día</p>
      </div>

      <div class="values-grid">
        {
          values.map((value, index) => (
            <div class={`value-card reveal reveal-delay-${(index % 4) + 1}`}>
              <div class="value-icon">{value.icon}</div>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="timeline-section">
      <div class="section-subtitle reveal">
        <h2>Nuestra Historia</h2>
        <p>El camino que nos ha llevado hasta donde estamos hoy</p>
      </div>

      <div class="timeline">
        {
          timelineEvents.map((event, index) => (
            <div class={`timeline-item ${index % 2 === 0 ? "left" : "right"} reveal reveal-delay-${(index % 3) + 1}`}>
              <div class="timeline-content">
                <div class="timeline-year">{event.year}</div>
                <h3>{event.title}</h3>
                <p>{event.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-light);
  }

  .about-content {
    display: flex;
    gap: 3rem;
    margin-top: 2rem;
  }

  .about-image {
    flex: 1;
  }

  .about-image img {
    width: 100%;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    object-fit: cover;
    aspect-ratio: 16/9; /* Mantiene una proporción consistente */
  }

  .about-text {
    flex: 1;
  }

  .about-text h3 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .about-text h3:first-child {
    margin-top: 0;
  }

  .about-text p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  .stats {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
    text-align: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    color: var(--color-primary);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-text {
    font-size: 0.9rem;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    margin: 5rem 0 3rem;
  }

  .section-subtitle h2 {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .section-subtitle p {
    color: var(--color-text);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Valores */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .value-card {
    background-color: white;
    border-radius: 10px;
    padding: 2rem;
    box-shadow: var(--shadow-md);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .value-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .value-card h3 {
    color: var(--color-primary);
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  /* Timeline */
  .timeline {
    position: relative;
    max-width: 1200px;
    margin: 4rem auto;
  }

  .timeline::after {
    content: "";
    position: absolute;
    width: 6px;
    background-color: var(--color-primary);
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -3px;
    border-radius: 3px;
  }

  .timeline-item {
    padding: 10px 40px;
    position: relative;
    width: 50%;
    box-sizing: border-box;
  }

  .timeline-item.left {
    left: 0;
  }

  .timeline-item.right {
    left: 50%;
  }

  .timeline-content {
    padding: 20px 30px;
    background-color: white;
    position: relative;
    border-radius: 10px;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .timeline-item:hover .timeline-content {
    box-shadow: var(--shadow-lg);
    transform: translateX(5px);
  }

  .timeline-item.right:hover .timeline-content {
    transform: translateX(-5px);
  }

  .timeline-content::after {
    content: "";
    position: absolute;
    width: 25px;
    height: 25px;
    background-color: white;
    border: 4px solid var(--color-primary);
    top: 20px;
    border-radius: 50%;
    z-index: 1;
  }

  .timeline-item.left .timeline-content::after {
    right: -17px;
  }

  .timeline-item.right .timeline-content::after {
    left: -17px;
  }

  .timeline-year {
    display: inline-block;
    padding: 5px 15px;
    background-color: var(--color-primary);
    color: white;
    font-weight: bold;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .timeline-content h3 {
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  @media (max-width: 992px) {
    .about-content {
      flex-direction: column;
    }

    .about-image img {
      max-height: 300px; /* Limitar altura en móviles */
      aspect-ratio: 1/1; /* Proporción más cuadrada en móviles */
      object-position: center; /* Asegura que la parte central sea visible */
    }

    .stats {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .stat {
      flex: 0 0 30%;
    }

    .timeline::after {
      left: 31px;
    }

    .timeline-item {
      width: 100%;
      padding-left: 70px;
      padding-right: 25px;
    }

    .timeline-item.right {
      left: 0;
    }

    .timeline-content::after {
      left: -17px !important;
    }
  }

  @media (max-width: 576px) {
    .about-image {
      margin-bottom: 1rem; /* Espacio después de la imagen */
    }

    .about-image img {
      max-height: 250px; /* Ajustar altura para móviles pequeños */
      aspect-ratio: 4/3; /* Proporción ligeramente rectangular pero no estirada */
    }

    .stat {
      flex: 0 0 100%;
      margin-bottom: 1.5rem;
    }

    .stats {
      flex-direction: column;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Contadores animados
    const statNumbers = document.querySelectorAll('.stat-number[data-target]');
    
    function animateCounter(element: HTMLElement) {
      const target = parseInt(element.getAttribute('data-target') || '0');
      const suffix = element.getAttribute('data-suffix') || '';
      const duration = 2000; // 2 segundos
      const steps = 60;
      const increment = target / steps;
      let current = 0;
      const stepTime = duration / steps;

      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        element.textContent = Math.floor(current) + suffix;
      }, stepTime);
    }

    // Observar cuando los stats entran en viewport
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const statNumber = entry.target as HTMLElement;
          if (!statNumber.classList.contains('animated')) {
            statNumber.classList.add('animated');
            animateCounter(statNumber);
            statsObserver.unobserve(statNumber);
          }
        }
      });
    }, { threshold: 0.5 });

    statNumbers.forEach(stat => {
      statsObserver.observe(stat);
    });
  });
</script>
